<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for serving the prerendered Angular app statically on
  Azure App Service (Windows). This file must sit at the served site root
  (dist/browser). It enforces a single canonical URL format:

    * one HTTP 301 removes any trailing slash (except the root "/"),
    * prerendered routes are served from "<route>/index.html" WITHOUT the
      IIS courtesy "add trailing slash" redirect,
    * unknown routes fall back to the SPA shell (index.html).

  This keeps the served URLs identical to the canonical tags, the sitemap,
  the hreflang alternates and the internal links (all without trailing slash).
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <rewrite>
      <rules>
        <!-- Note: enforce HTTPS via App Service > TLS/SSL settings > "HTTPS Only"
             (doing it here with {HTTPS} would loop behind Azure's TLS proxy). -->

        <!-- 1) Remove trailing slash (301), except for the site root. -->
        <rule name="RemoveTrailingSlash" stopProcessing="true">
          <match url="^(.+)/$" />
          <action type="Redirect" url="{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2) Serve the prerendered index.html for routes that have one,
                without letting IIS 301-redirect the directory to add a slash. -->
        <rule name="PrerenderedRoute" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}\index.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}/index.html" />
        </rule>

        <!-- 3) SPA fallback: routes with no prerendered page and no static
                file are served the app shell so Angular can route them. -->
        <rule name="SpaFallback" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

    <caching enabled="true" enableKernelCache="true" />
  </system.webServer>
</configuration>
