{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "simplevlogeditor": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "webWorkerTsConfig": "tsconfig.worker.json",
            "assets": [
              "src/favicon.ico",
              "src/robots.txt",
              "src/currentversion",
              "src/currentversion.json",
              "src/sitemap.xml",
              "src/web.config",
              "src/assets",
              {
                "glob": "ort-wasm-simd-threaded{,.asyncify}.wasm",
                "input": "node_modules/onnxruntime-web/dist/",
                "output": "assets/onnxruntime/"
              }
            ],
            "styles": [
              "@angular/material/prebuilt-themes/purple-green.css",
              "src/styles.css"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "debug",
              "encoding",
              "is-url",
              "lie",
              "pako",
              "qrcode",
              "readable-stream",
              "regenerator-runtime/runtime",
              "setimmediate",
              "whatwg-url"
            ],
            "externalDependencies": ["onnxruntime-node"],
            "server": "src/main.server.ts",
            "prerender": true,
            "ssr": { "entry": "server.ts" }
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "3mb", "maximumError": "5mb" },
                { "type": "anyComponentStyle", "maximumWarning": "40kb", "maximumError": "50kb" }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "build-mobile": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist-mobile",
            "index": "src/index.html",
            "browser": "src/main.mobile.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.mobile.json",
            "webWorkerTsConfig": "tsconfig.worker.json",
            "assets": [
              "src/favicon.ico",
              "src/currentversion",
              "src/currentversion.json",
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets",
                "ignore": ["download/**"]
              },
              {
                "glob": "ort-wasm-simd-threaded{,.asyncify}.wasm",
                "input": "node_modules/onnxruntime-web/dist/",
                "output": "assets/onnxruntime/"
              }
            ],
            "styles": ["@angular/material/prebuilt-themes/purple-green.css", "src/styles.css"],
            "scripts": [],
            "externalDependencies": ["onnxruntime-node"]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "optimization": { "scripts": true, "styles": true, "fonts": false },
              "budgets": [
                { "type": "initial", "maximumWarning": "3mb", "maximumError": "5mb" },
                { "type": "anyComponentStyle", "maximumWarning": "40kb", "maximumError": "50kb" }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "simplevlogeditor:build:production" },
            "development": { "buildTarget": "simplevlogeditor:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": { "buildTarget": "simplevlogeditor:build" }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "tsconfig.spec.json",
            "webWorkerTsConfig": "tsconfig.worker.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "ort-wasm-simd-threaded{,.asyncify}.wasm",
                "input": "node_modules/onnxruntime-web/dist/",
                "output": "assets/onnxruntime/"
              }
            ],
            "styles": ["@angular/material/prebuilt-themes/purple-green.css", "src/styles.css"],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "cache": {
      "enabled": true,
      "environment": "all",
      "path": ".angular/cache"
    },
    "analytics": "f0df6d6c-d1f3-427c-a989-0d0a2b6c6342"
  }
}
